    "./reading-profiles": "./src/reading-profiles.js",
    "./academic-preview": "./src/academic-preview.js",
    "./structured-math": "./src/structured-math.js",
    "./math-symbols": "./src/math-symbols.js",
    "./math-functions": "./src/math-functions.js",
    "./math-variable-labels": "./src/math-variable-labels.js",
    "./math-collections": "./src/math-collections.js",
    "./math-fractions": "./src/math-fractions.js",
    "./test/math-golden-fixtures": "./test/math-golden-fixtures.cjs",
    "./pdf-layout": "./src/pdf-layout.js",
    "./pdf-heading-hierarchy": "./src/pdf-heading-hierarchy.js",
    "./playback-queue": "./src/playback-queue.js",
    "./reading-position": "./src/reading-position.js",
    "./semantic-chunker": "./src/semantic-chunker.js",
    "./task-state": "./src/task-state.js",
